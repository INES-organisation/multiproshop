# Copier vers deploy/.env sur le VPS (fichier non versionné, chmod 600).
INES_NETWORK=ines_ines-network
APP_URL=https://multiproshop.com

# Générer avec : python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Base « multiproshop » dans ines-postgres (utilisateur dédié, propriétaire de sa base)
DATABASE_URL=postgresql://multiproshop:MOT_DE_PASSE@ines-postgres:5432/multiproshop

# Redis d'INES : mot de passe = REDIS_PASSWORD du .env.production d'INES
REDIS_URL=redis://:REDIS_PASSWORD@ines-redis:6379/10
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@ines-redis:6379/11

# CJ Dropshipping — NOUVELLES clés (les anciennes ont été publiées dans le dépôt)
CJ_EMAIL=
CJ_PASSWORD=
CJ_DEV_KEY=
CJ_WEBHOOK_SECRET=
CJ_VERIFY_SSL=True
CJ_DEBUG_ENABLED=False
CJ_LOG_REQUESTS=False

# Paiement : passera par le Stripe d'INES (étape 3 du plan). D'ici là, laisser vide.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails : passeront par INES (étape 4). D'ici là, SMTP direct si besoin.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@multiproshop.com
