# Copier vers deploy/.env sur le VPS (fichier non versionné, chmod 600).
INES_NETWORK=ines_ines-network
APP_URL=https://multiproshop.com

# Générer avec : python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Base « multiproshop » dans ines-postgres (utilisateur dédié, propriétaire de sa base)
DATABASE_URL=postgresql://multiproshop:MOT_DE_PASSE@ines-postgres:5432/multiproshop

# Redis d'INES : mot de passe = REDIS_PASSWORD du .env.production d'INES
REDIS_URL=redis://:REDIS_PASSWORD@ines-redis:6379/10
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@ines-redis:6379/11

# CJ Dropshipping : clés gérées dans INES → /admin/integrations, sous le préfixe MULTIPROSHOP_
# (MULTIPROSHOP_CJ_EMAIL, MULTIPROSHOP_CJ_PASSWORD, MULTIPROSHOP_CJ_DEV_KEY, MULTIPROSHOP_CJ_WEBHOOK_SECRET).
# Lues au démarrage (redémarrer les conteneurs après un changement) ; ici seulement en secours.
CJ_VERIFY_SSL=True
CJ_DEBUG_ENABLED=False
CJ_LOG_REQUESTS=False

# INES : paiement par le Stripe d'INES (clés Stripe uniquement dans INES → /admin/integrations).
# Clé API INES d'un compte administrateur (INES → Clés API). Sans clé : paiement indisponible.
INES_API_URL=http://ines-backend:8000
INES_API_KEY=

# E-mails : envoyés par le fournisseur d'INES (même clé INES_API_KEY), plus de SMTP ni de Gmail.
# Expéditeur facultatif, à déclarer chez le fournisseur d'INES ; sinon celui d'INES, nom « MultiProShop ».
MAIL_FROM=

# Quota API CJ (1 000 requêtes par jour pour tout le compte) : produits mis à jour par passage
CJ_STOCK_SYNC_BATCH=15
CJ_VARIANT_SYNC_BATCH=30
# Import quotidien de 100 produits CJ au hasard (ancien comportement) : laisser à false
CJ_AUTO_IMPORT_PRODUCTS=false
