# Aller dans le dossier du projet
Set-Location "C:\Users\Anthony\CascadeProjects\multiproshop"

# Lancer le script PowerShell
.\run_multiproshop.ps1


# Lancer Celery
.\start_celery.bat

# Arrêter Celery (dans un autre terminal ou après)
.\stop_celery.bat

# Récupérer TOUS les produits CJ (des dizaines de milliers)
python scripts\sync_all_cj_products.py

# Enrichissement COMPLET (variantes + détails + stock + avis + description)
python scripts\full_enrich_all_products.py

# OU enrichissement rapide (variantes uniquement)
python scripts\enrich_all_products_now.py

# Synchroniser les STOCKS via listV2 (seul endpoint CJ avec les stocks)
python scripts\sync_stocks_v2_global.py

# Vider le cache + corriger les compteurs
python scripts\clear_cache_and_enrich.py
python scripts\fix_cj_stats_counters.py

# Enrichissement complet (stocks + détails + variantes + avis)
python scripts\fast_enrich_all.py

# Seulement les stocks (très rapide, ~1 min pour des milliers)
python scripts\fast_enrich_all.py --stock-only

# Forcer le ré-enrichissement même si fait récemment
python scripts\fast_enrich_all.py --force

# Plus de threads pour aller plus vite (attention au rate limit)
python scripts\fast_enrich_all.py --workers 5

# Sans les avis (plus rapide, les avis sont lents)
python scripts\fast_enrich_all.py --no-ratings

# Combiner les options
python scripts\fast_enrich_all.py --workers 5 --no-ratings

python scripts/sync_shipping_rates.py

